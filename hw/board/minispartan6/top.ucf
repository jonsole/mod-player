# Pins for the Scarab miniSpartan6+ (XC6SLX25-3FTG256), from Scarab's
# published miniSpartan6-plus.ucf (Rev B), renamed to match top.v.

NET "CLK50" LOC = "K3" | IOSTANDARD = LVTTL;
NET "CLK50" TNM_NET = "clk50";
TIMESPEC "TS_clk50" = PERIOD "clk50" 20 ns HIGH 50%;

# LEDs
NET "LEDS<0>" LOC = "P11" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<1>" LOC = "N9"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<2>" LOC = "M9"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<3>" LOC = "P9"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<4>" LOC = "T8"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<5>" LOC = "N8"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<6>" LOC = "P8"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;
NET "LEDS<7>" LOC = "P7"  | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = SLOW;

# DIP switches (to ground when on)
NET "SW<1>" LOC = "L1" | IOSTANDARD = LVTTL | PULLUP;
NET "SW<2>" LOC = "L3" | IOSTANDARD = LVTTL | PULLUP;
NET "SW<3>" LOC = "L4" | IOSTANDARD = LVTTL | PULLUP;
NET "SW<4>" LOC = "L5" | IOSTANDARD = LVTTL | PULLUP;

# FT2232H channel B in serial (UART) mode
NET "FTDI_D0" LOC = "M7" | IOSTANDARD = LVTTL | PULLUP;   # FT2232H TXD -> FPGA
NET "FTDI_D1" LOC = "N6" | IOSTANDARD = LVTTL;            # FPGA -> FT2232H RXD

# Audio jack (through RC filters)
NET "AUDIO1" LOC = "B8" | IOSTANDARD = LVTTL | DRIVE = 8;  # ring: right
NET "AUDIO2" LOC = "A8" | IOSTANDARD = LVTTL | DRIVE = 8;  # tip: left

# SDRAM
NET "SDRAM_CLK"  LOC = "G16" | IOSTANDARD = LVTTL | DRIVE = 8 | SLEW = FAST;
NET "SDRAM_CKE"  LOC = "H16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_CSn"  LOC = "R1"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_RASn" LOC = "R2"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_CASn" LOC = "T4"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_WEn"  LOC = "R5"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_BA<0>" LOC = "R14" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_BA<1>" LOC = "T14" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_LDQM" LOC = "T5"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_UDQM" LOC = "F15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<0>"  LOC = "T15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<1>"  LOC = "R16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<2>"  LOC = "P15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<3>"  LOC = "P16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<4>"  LOC = "N16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<5>"  LOC = "M15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<6>"  LOC = "M16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<7>"  LOC = "L16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<8>"  LOC = "K15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<9>"  LOC = "K16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<10>" LOC = "R15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<11>" LOC = "J16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_A<12>" LOC = "H15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<0>"  LOC = "T13" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<1>"  LOC = "T12" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<2>"  LOC = "R12" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<3>"  LOC = "T9"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<4>"  LOC = "R9"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<5>"  LOC = "T7"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<6>"  LOC = "R7"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<7>"  LOC = "T6"  | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<8>"  LOC = "F16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<9>"  LOC = "E15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<10>" LOC = "E16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<11>" LOC = "D16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<12>" LOC = "B16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<13>" LOC = "B15" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<14>" LOC = "C16" | IOSTANDARD = LVTTL | SLEW = FAST;
NET "SDRAM_D<15>" LOC = "C15" | IOSTANDARD = LVTTL | SLEW = FAST;
